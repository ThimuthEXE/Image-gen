# ===================================================
# AI Image Studio - Environment Variables Configuration
# ===================================================

# OpenAI API Key (Required for live generation)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Image Generation Model
# Default specified: gpt-image-2.5-sunburst (or dall-e-3)
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Demo Fallback Mode (optional: set to true to allow demo mock previews if no OpenAI key is set)
ENABLE_DEMO_FALLBACK=true
